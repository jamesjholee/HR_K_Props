+_VERDICTS = """(SELECT DISTINCT slate_date, pitcher_id, verdict, whiff
+                FROM pitcher_verdicts)"""
+
 _STARTER_HRS = """(SELECT date, pitcher_id, COUNT(*) n FROM hr_finals
                    WHERE pitcher_role='S' GROUP BY date, pitcher_id)"""
 
